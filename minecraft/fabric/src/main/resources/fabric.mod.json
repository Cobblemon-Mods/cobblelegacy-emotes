{
  "schemaVersion": 1,
  "id": "emotecraft",
  "version": "${version}",
  "name": "Emotecraft (CobbleLegacy)",
  "description": "${description}",
  "authors": [
    "KosmX",
    "dima_dencep",
    "CobbleLegacy"
  ],
  "contributors": [
    "Kale Ko"
  ],
  "contact": {
    "issues": "https://github.com/KosmX/emotes/issues",
    "homepage": "https://kosmx.gitbook.io/emotecraft/",
    "sources": "https://github.com/Cobblemon-Mods/cobblelegacy-emotes"
  },
  "license": "GPL3",
  "icon": "emotecraft_mod_logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "io.github.kosmx.emotes.fabric.FabricWrapper",
      {
        "value": "fr.owme.cobblelegacy.emotes.CobbleLegacyEmotes",
        "adapter": "kotlin"
      }
    ],
    "client": [
      "io.github.kosmx.emotes.fabric.ClientInit",
      {
        "value": "fr.owme.cobblelegacy.emotes.client.CobbleLegacyEmotesClient",
        "adapter": "kotlin"
      }
    ],
    "server": [],
    "modmenu": [
      "io.github.kosmx.emotes.fabric.ModMenu"
    ]
  },
  "mixins": [
    "emotecraft-arch.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.14.11",
    "fabric-api": "*",
    "fabric-language-kotlin": "*",
    "minecraft": "~1.21.1",
    "playeranimator": ">=2.0.0+1.21.1"
  },
  "suggests": {
    "cobblelegacy-libs": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/6NfdRuE"
      }
    }
  }
}
